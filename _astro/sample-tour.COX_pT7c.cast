u001b[0m                                                                                                                                                              \u001b[0;36m│\u001b[0m\u001b[17;1H\u001b[0;36m│\u001b[0m  \u001b[0;36marchitecture_ref\u001b[0m: \u001b[0;32m\"shared/architecture/\"\u001b[0m                                                                                                                                                            \u001b[0;36m│\u001b[0m\u001b[18;1H\u001b[0;36m│\u001b[0m  \u001b[0;36mdesign_system_ref\u001b[0m: \u001b[0;32m\"shared/design_system/\"\u001b[0m                                                                                                                                                          \u001b[0;36m│\u001b[0m\u001b[19;1H\u001b[0;36m│\u001b[0m  \u001b[0;36mscope\u001b[0m: \u001b[0;32m\"team\"\u001b[0m                                                                                                                                                                                       \u001b[0;36m│\u001b[0m\u001b[20;1H\u001b[0;36m│\u001b[0m  \u001b[0;36mprimary_dimension\u001b[0m: \u001b[0;32m\"I_CAN\"\u001b[0m                                                                                                                                                                          \u001b[0;36m│\u001b[0m\u001b[21;1H\u001b[0;36m│\u001b[0m  \u001b[0;36mjourney_phase\u001b[0m: \u001b[0;32m\"TRANSFORM_SELF\"\u001b[0m                                                                                                                                                                     \u001b[0;36m│\u001b[0m\u001b[22;1H\u001b[0;36m│\u001b[0m  \u001b[0;36mpain_statement\u001b[0m: >                                                                                                                                                                                   \u001b[0;36m│\u001b[0m\u001b[23;1H\u001b[0;36m│\u001b[0m    \u001b[0;32mNobody wants to count tins before every trip to the shop, but everyone notices when the rice has run out.\u001b[0m                                                                                         \u001b[0;36m│\u001b[0m\u001b[24;1H\u001b[0;36m│\u001b[0;32m  \u001b[0;36mwhat_you_get\u001b[0m:                                                                                                                                                                                       \u001b[0;36m│\u001b[0m\u001b[25;1H\u001b[0;36m│\u001b[0m    - \u001b[0;32m\"A list of everything in the pantry with its quantity and where it is kept\"\u001b[0m                                                                                                                     \u001b[0;36m│\u001b[0m\u001b[26;1H\u001b[0;36m│\u001b[0m    - \u001b[0;32m\"A warning when an item drops below its threshold or nears its date\"\u001b[0m                                                                                                                            \u001b[0;36m│\u001b[0m\u001b[27;1H\u001b[0;36m│\u001b[0m  \u001b[0;36mshared_dependencies\u001b[0m: []                                                                                                                                                                             \u001b[0;36m│\u001b[0m\u001b[28;1H\u001b[0;36m│\u001b[0m  \u001b[0;36muser_stories_ref\u001b[0m: \u001b[0;32m\"\"\u001b[0m                                                                                                                                                                                \u001b[0;36m│\u001b[0m\u001b[29;1H\u001b[0;36m│\u001b[0m  \u001b[0;36msource_files\u001b[0m: []                                                                                                                                                                                    \u001b[0;36m│\u001b[0m\u001b[30;1H\u001b[0;36m│\u001b[0m  \u001b[0;36mchangelog_ref\u001b[0m: \u001b[0;32m\"apps/pantry/m02_pantry/CHANGELOG.md\"\u001b[0m                                                                                                                                                \u001b[0;36m│\u001b[0m\u001b[31;1H\u001b[0;36m│\u001b[0m  \u001b[0;36mux_ref\u001b[0m:                                                                                                                                                                                             \u001b[0;36m│\u001b[0m\u001b[32;1H\u001b[0;36m│\u001b[0m    \u001b[0;36mjourneys\u001b[0m: []                                                                                                                                                                                      \u001b[0;36m│\u001b[0m\u001b[33;1H\u001b[0;36m│\u001b[0m    \u001b[0;36mfeatures\u001b[0m: []                                                                                                                                                                                      \u001b[0;36m│\u001b[0m\u001b[34;1H\u001b[0;36m│\u001b[0m                                                                                                                                                                                                      \u001b[0;36m│\u001b[0m\u001b[35;1H\u001b[0;36m│aggregate_contract\u001b[0m:                                                                                                                                                                                   \u001b[0;36m│\u001b[0m\u001b[36;1H\u001b[0;36m│\u001b[0m  \u001b[0;36mowns\u001b[0m: [\u001b[0;32m\"pantry_item\"\u001b[0m, \u001b[0;32m\"storage_location\"\u001b[0m]                                                                                                                                                           \u001b[0;36m│\u001b[0m\u001b[37;1H\u001b[0;36m│\u001b[0m  \u001b[0;36mstream_patterns\u001b[0m: [\u001b[0;32m\"pantry-item-{itemId}\"\u001b[0m]                                                                                                                                                           \u001b[0;36m│\u001b[0m\u001b[38;1H\u001b[0;36m│\u001b[0m  \u001b[0;36mevent_sourced\u001b[0m: \u001b[0;33mtrue\u001b[0m                                                                                                                                                                                 \u001b[0;36m│\u001b[0m\u001b[39;1H\u001b[0;36m│\u001b[0m  \u001b[0;36minvariants\u001b[0m:                                                                                                                                                                                         \u001b[0;36m│\u001b[0m\u001b[40;1H\u001b[0;36m│\u001b[0m    - \u001b[0;32m\"A quantity is never below zero\"\u001b[0m                                                                                                                                                                \u001b[0;36m│\u001b[0m\u001b[41;1H\u001b[0;36m│\u001b[0m    - \u001b[0;32m\"Every item has a low-stock threshold\"\u001b[0m                                                                                                                                                          \u001b[0;36m│\u001b[0m\u001b[42;1H\u001b[0;36m│\u001b[0m    - \u001b[0;32m\"Every item is kept in one storage location\"\u001b[0m                                                                                                                                                    \u001b[0;36m│\u001b[0m\u001b[43;1H\u001b[0;36m│\u001b[0m  \u001b[0;36mextends_module\u001b[0m: \u001b[0;33mnull\u001b[0m                                                                                                                                                                                \u001b[0;36m│\u001b[0m\u001b[44;1H\u001b[0;36m│\u001b[0m  \u001b[0;36mnever_crosses_into\u001b[0m: []                                                                 