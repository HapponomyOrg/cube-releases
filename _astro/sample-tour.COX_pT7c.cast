[7.060, "o", "\u001b[2;1H\u001b[0;36m┌ tldr: Module m02 of pantry: what is in the pantry, where it is kept, and what is running low ────────────────────────────────────────────────────────────────────────────────────────────────────────┐\u001b[0m\u001b[3;1H\u001b[0;36m│▌ \u001b[0;1;36mtl;dr \u001b[0mModule m02 of pantry: what is in the pantry, where it is kept, and what is running low                                                                                                        \u001b[0;36m│\u001b[0m\u001b[4;1H\u001b[0;36m│\u001b[0;90m──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0;36m│\u001b[0m\u001b[5;1H\u001b[0;36m│\u001b[0;90m# tldr: Module m02 of pantry: what is in the pantry, where it is kept, and what is running low\u001b[0m                                                                                                        \u001b[0;36m│\u001b[0m\u001b[6;1H\u001b[0;36m│\u001b[0;90m# MODULE SPEC -- Pantry, a module of the pantry sample app.\u001b[0m                                                                                                                                           \u001b[0;36m│\u001b[0m\u001b[7;1H\u001b[0;36m│\u001b[0m                                                                                                                                                                                                      \u001b[0;36m│\u001b[0m\u001b[8;1H\u001b[0;36m│identity\u001b[0m:                                                                                                                                                                                             \u001b[0;36m│\u001b[0m\u001b[9;1H\u001b[0;36m│\u001b[0m  \u001b[0;36mmodule_id\u001b[0m: \u001b[0;32m\"m02\"\u001b[0m                                                                                                    