36m│\u001b[0;90m│\u001b[0m                                                                  \u001b[0;90m││\u001b[0m                        \u001b[0;90m│\u001b[0m\u001b[11;1H\u001b[0;36m│\u001b[0m  kit.yml               \u001b[0;36m│\u001b[0;90m│\u001b[0;1;36m## What this module is for\u001b[0m                                        \u001b[0;90m││\u001b[0m                        \u001b[0;90m│\u001b[0m\u001b[13;1H\u001b[0;36m│\u001b[0m                        \u001b[0;36m│\u001b[0;90m│\u001b[0mEvery spec points at the conventions through                      \u001b[0;90m││\u001b[0m                        \u001b[0;90m│\u001b[0m\u001b[14;1H\u001b[0;36m│\u001b[0m                        \u001b[0;36m│\u001b[0;90m│\u001b[0;97;40midentity.conventions_ref: shared/conventions/\u001b[0m. The conventions say\u001b[0;90m││\u001b[0m                        \u001b[0;90m│\u001b[0m\u001b[15;1H\u001b[0;36m│\u001b[0m                        \u001b[0;36m│\u001b[0;90m│\u001b[0mwhat things are called, how specs are numbered and identified,    \u001b[0;90m││\u001b[0m                        \u001b[0;90m│\u001b[0m\u001b[16;1H\u001b[0;36m│\u001b[0m                        \u001b[0;36m│\u001b[0;90m│\u001b[0mwhere each piece of data lives (one authoritative home per value),\u001b[0;90m││\u001b[0m                        \u001b[0;90m│\u001b[0m\u001b[17;1H\u001b[0;36m│\u001b[0m                        \u001b[0;36m│\u001b[0;90m│\u001b[0mwhich words the KB uses, and which decisions were taken and why.  \u001b[0;90m││\u001b[0m                        \u001b[0;90m│\u001b[0m\u001b[19;1H\u001b[0;36m│\u001b[0m                        \u001b[0;36m│\u001b[0;90m│\u001b[0;1;36m## How it gets filled\u001b[0m                                             \u001b[0;90m││\u001b[0m                        \u001b[0;90m│\u001b[0m\u001b[21;1H\u001b[0;36m│\u001b[0m                        \u001b[0;36m│\u001b[0;90m│\u001b[0mAsk your agent to write the KB conventions. The skill             \u001b[0;90m││\u001b[0m                        \u001b[0;90m│\u001b[0m\u001b[22;1H\u001b[0;36m│\u001b[0m                        \u001b[0;36m│\u001b[0;90m│\u001b[0;97;40m.claude/skills/writing-kb-conventions/\u001b[0m asks about your apps and   \u001b[0;90m││\u001b[0m                        \u001b[0;90m│\u001b[0m\u001b[23;1H\u001b[0;36m│\u001b[0m                        \u001b[0;36m│\u001b[0;90m│\u001b[0mlayers, writes each document from its templates, and runs \u001b[0;97;40mcube\u001b[0m    \u001b[0;90m││\u001b[0m                        \u001b[0;90m│\u001b[0m\u001b[24;1H\u001b[0;36m│\u001b[0m                        \u001b[0;36m│\u001b[0;90m│\u001b[0;97;40mcheck\u001b[0m after each file.                                            \u001b[0;90m││\u001b[0m                        \u001b[0;90m│\u001b[0m\u001b[26;1H\u001b[0;36m│\u001b[0m                        \u001b[0;36m│\u001b[0;90m│\u001b[0;1;36m## Status\u001b[0m                                                         \u001b[0;90m││\u001b[0m                        \u001b[0;90m│\u001b[0m\u001b[28;1H\u001b[0;36m│\u001b[0m                        \u001b[0;36m│\u001b[0;90m│\u001b[0mSPECCED skeleton, version 0.1.0. See \u001b[0;97;40mCHANGELOG.md\u001b[0m.                \u001b[0;90m││\u001b[0m                        \u001b[0;90m│\u001b[0m"]
