\u001b[13;1H\u001b[0;36m│\u001b[0m                                                                                                                      \u001b[0;36m│\u001b[0m\u001b[14;1H\u001b[0;36m│identity\u001b[0m:                                                                                                             \u001b[0;36m│\u001b[0m\u001b[15;1H\u001b[0;36m│\u001b[0m  \u001b[0;36mmodule_id\u001b[0m: \u001b[0;32m\"shared_conventions\"\u001b[0m                                                                                     \u001b[0;36m│\u001b[0m\u001b[16;1H\u001b[0;36m│\u001b[0m  \u001b[0;36mapp_scope\u001b[0m: \u001b[0;32m\"shared\"\u001b[0m                                                                                                 \u001b[0;36m│\u001b[0m\u001b[17;1H\u001b[0;36m│\u001b[0m  \u001b[0;36mname\u001b[0m: \u001b[0;32m\"Conventions\"\u001b[0m                                                                                                 \u001b[0;36m│\u001b[0m\u001b[18;1H\u001b[0;36m│\u001b[0m  \u001b[0;36mtagline\u001b[0m: \u001b[0;32m\"One source of truth for what things are called and where each piece of data lives\"\u001b[0m                        \u001b[0;36m│\u001b[0m\u001b[19;1H\u001b[0;36m│\u001b[0m  \u001b[0;36mmodule_status\u001b[0m: \u001b[0;32m\"ACTIVE\"\u001b[0m                                                                                             \u001b[0;36m│\u001b[0m\u001b[20;1H\u001b[0;36m│\u001b[0m  \u001b[0;36mstatus\u001b[0m: \u001b[0;32m\"SPECCED\"   # a skeleton: no rule document is written yet\u001b[0m                                                   \u001b[0;36m│\u001b[0m\u001b[21;1H\u001b[0;36m│\u001b[0m  \u001b[0;36msync_state\u001b[0m: \u001b[0;32m\"stable\"\u001b[0m                                                                                                \u001b[0;36m│\u001b[0m\u001b[22;1H\u001b[0;36m│\u001b[0m  \u001b[0;36mversion\u001b[0m: \u001b[0;32m\"0.1.0\"\u001b[0m                                                                                                    \u001b[0;36m│\u001b[0m\u001b[23;1H\u001b[0;36m│\u001b[0m  \u001b[0;36mconventions_ref\u001b[0m: \u001b[0;32m\"\"        # intentional self-reference exemption -- this module IS the convention\u001b[0m                  \u001b[0;36m│\u001b[0m\u001b[24;1H\u001b[0;36m│\u001b[0m  \u001b[0;36mdesign_system_ref\u001b[0m: \u001b[0;32m\"shared/design_system/\"\u001b[0m                                                                          \u001b[0;36m│\u001b[0m\u001b[25;1H\u001b[0;36m│\u001b[0m  \u001b[0;36marchitecture_ref\u001b[0m: \u001b[0;32m\"shared/architecture/\"\u001b[0m                                                                            \u001b[0;36m│\u001b[0m\u001b[26;1H\u001b[0;36m│\u001b[0m  \u001b[0;36mscope\u001b[0m: \u001b[0;32m\"composite\"\u001b[0m                                                                                                  \u001b[0;36m│\u001b[0m\u001b[27;1H\u001b[0;36m│\u001b[0m  \u001b[0;36mprimary_dimension\u001b[0m: \u001b[0;32m\"COMPOSITE\"\u001b[0m                                                                                      \u001b[0;36m│\u001b[0m\u001b[28;1H\u001b[0;36m│\u001b[0m  \u001b[0;36mjourney_phase\u001b[0m: \u001b[0;32m\"UNDERSTAND\"\u001b[0m                                                                                         \u001b[0;36m│\u001b[0m\u001b[29;1H\u001b[0;36m│\u001b[0m  \u001b[0;36mpain_statement\u001b[0m: >                                                                                                   \u001b[0;36m│\u001b[0m\u001b[30;1H\u001b[0;36m│\u001b[0m    \u001b[0;32mWhen naming and data-placement rules live in many playbooks and none is\u001b[0m                                           \u001b[0;36m│\u001b[0m\u001b[31;1H\u001b[0;36m│\u001b[0;32m    authoritative, every slice rediscovers them, one concept gets several names, and\u001b[0m                                  \u001b[0;36m│\u001b[0m\u001b[32;1H\u001b[0;36m│\u001b[0;32m    the same data lands in several tables without anyone saying which copy is the truth.\u001b[0m                              \u001b[0;36m│\u001b[0m\u001b[33;1H\u001b[0;36m│\u001b[0;32m  \u001b[0;36mwhat_you_get\u001b[0m:                                                                                                       \u001b[0;36m│\u001b[0m\u001b[34;1H\u001b[0;36m│\u001b[0m    - \u001b[0;32m\"A naming convention per layer (events, streams, tables, columns, payloads, files) with examples\"\u001b[0m               \u001b[0;36m│\u001b[0m\u001b[35;1H\u001b[0;36m└──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────┘\u001b[0m"]
